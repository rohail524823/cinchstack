---
import Base from '../../layouts/Base.astro';
import { SITE, NAME, ORG_ID } from '../../lib/site.mjs';
import { tools, pricing, toolIds, cheapestPaid, noPaidPlan, scenario, sizeBasis } from '../../lib/data.mjs';
import { LAYER_LABELS } from '../../lib/schemas.mjs';
import { registry } from '../../lib/pages.mjs';
import { longDate } from '../../lib/format.mjs';
import { LICENSE, CITATION, lastChecked } from '../../lib/dataset.mjs';
import { breadcrumbNode, webPageNode } from '../../lib/jsonld.mjs';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Fig from '../../components/Fig.astro';

const reg = await registry();
const path = '/data/';
const url = `${SITE}${path}`;
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Pricing dataset' }];
const title = 'Software pricing dataset (free to reuse, CC BY 4.0)';
const description = 'Download the CinchStack software pricing dataset as JSON or CSV: every plan, add-on, usage fee and team-size cost we track, dated and sourced. CC BY 4.0.';
const latest = lastChecked();
const nPlans = Object.values(pricing).reduce((a, p) => a + p.plans.length, 0);
const nScen = Object.values(pricing).reduce((a, p) => a + p.scenarios.length, 0);
const toolHref = (id) => (reg.has(`/tools/${id}/pricing/`) ? `/tools/${id}/pricing/` : null);
const oldest = Object.values(pricing).map((p) => p.checkedOn).sort()[0];

// "What the data shows": computed at build time from the same records as scenarios.csv, so every
// number below moves when a price changes.
const gaps = toolIds.map((id) => { const c = cheapestPaid(id); const sm = scenario(id, 'small'); return c && sm ? { id, c, sm, ratio: sm.monthly / c.v } : null; }).filter(Boolean);
const above = gaps.filter((g) => g.sm.monthly > g.c.v).length;
const sorted = [...gaps].sort((a, b) => a.ratio - b.ratio);
const mid = sorted.length / 2;
const median = sorted.length % 2 ? sorted[Math.floor(mid)].ratio : (sorted[mid - 1].ratio + sorted[mid].ratio) / 2;
const widest = sorted.slice(-3).reverse();
// The widest gaps are partly texting: a small-team bill that includes texts is not like-for-like.
const wideTexting = widest.filter((g) => /, with texting$/.test(sizeBasis(g.id, 'small'))).map((g) => tools[g.id].name);
const wideNote = wideTexting.length === 0 ? ''
  : wideTexting.length === 1 ? `${wideTexting[0]}'s small-team bill includes texting, which widens that gap. `
  : `The ${wideTexting.slice(0, -1).join(', ')} and ${wideTexting.at(-1)} small-team bills include texting, which widens those gaps. `;
const narrowest = sorted.slice(0, 3);
const otherPlan = gaps.filter((g) => g.sm.planId !== g.c.p.id).length;
const perSeat = gaps.filter((g) => g.c.p.priceUnit === 'per-seat-month').length;
const metered = toolIds.filter((id) => pricing[id].usage.length > 0).length;
const withAddOns = toolIds.filter((id) => pricing[id].addOns.length > 0).length;
const freePlans = toolIds.filter((id) => pricing[id].freeTier.exists).length;
const times = (r) => (Math.round(r * 10) / 10).toFixed(1);
// What a five-person business counts as in two jobs, from the same basis the pricing pages show.
const basisFor = (pred) => { const id = toolIds.find((x) => pred(tools[x])); return id ? sizeBasis(id, 'small').split(',')[0] : null; };
const crmSmall = basisFor((t) => t.layer === 'run');
const seoSmall = basisFor((t) => t.layer === 'grow' && /\bseo\b/i.test(t.category));
const snippet = `Source: <a href="${url}">${NAME} software pricing dataset</a>, prices checked ${longDate(latest)}, licensed <a href="${LICENSE}">CC BY 4.0</a>.`;
const dataset = {
  '@type': 'Dataset',
  '@id': `${url}#dataset`,
  name: `${NAME} software pricing dataset`,
  description: 'US list prices for small-business software (plans, add-ons, usage fees and extra costs) read from each vendor\'s pricing page, with the date checked and the source URL, plus estimated monthly costs at three team sizes.',
  url,
  license: LICENSE,
  // The credit line shown under "How to cite this data".
  citation: CITATION,
  creditText: CITATION,
  isAccessibleForFree: true,
  creator: { '@id': ORG_ID },
  publisher: { '@id': ORG_ID },
  dateModified: latest,
  // The files carry no version number of their own; they are versioned by the date of the newest check.
  version: latest ?? undefined,
  // "All money is US dollars, as shown to a US buyer" (Field notes).
  spatialCoverage: { '@type': 'Place', name: 'United States' },
  // How each figure is collected, in the words of /methodology/ ("How we read a price").
  measurementTechnique: [
    "Each price is read from the vendor's own pricing page, opened in a headless Chromium browser set to a US location and saved as a dated plain-text copy; a script checks every recorded figure against the saved copy it cites.",
    `${SITE}/methodology/#how-we-read-a-price`,
  ],
  temporalCoverage: latest ? `${Object.values(pricing).map((p) => p.checkedOn).sort()[0]}/${latest}` : undefined,
  keywords: ['software pricing', 'SaaS pricing', 'CRM pricing', 'ecommerce platform pricing', 'email marketing pricing', 'website builder pricing'],
  variableMeasured: ['monthly price (USD)', 'annual price per month (USD)', 'add-on price (USD)', 'usage rate (USD)', 'estimated monthly cost by team size (USD)'],
  distribution: [
    // Named as the download buttons name them.
    { '@type': 'DataDownload', name: 'Full dataset (JSON)', encodingFormat: 'application/json', contentUrl: `${SITE}/data/pricing.json` },
    { '@type': 'DataDownload', name: 'Plans CSV', encodingFormat: 'text/csv', contentUrl: `${SITE}/data/pricing.csv` },
    { '@type': 'DataDownload', name: 'Team-cost CSV', encodingFormat: 'text/csv', contentUrl: `${SITE}/data/scenarios.csv` },
  ],
};
---
<Base title={title} description={description} path={path} jsonld={[breadcrumbNode(url, crumbs), { ...webPageNode({ url, name: title, description, lastReviewed: latest }), mainEntity: { '@id': dataset['@id'] } }, dataset]}>
  <div class="wrap page">
    <div class="read">
      <Breadcrumbs crumbs={crumbs} />
      <h1>The CinchStack pricing dataset</h1>
      <p class="lede">Everything we record about software prices, in one file you can download and reuse. It covers {toolIds.length} tools, {nPlans} plans and {nScen} team-size cost estimates, each with the date we checked and the vendor page we read.</p>
      {latest && <p class="muted">Last checked: <time datetime={latest}>{longDate(latest)}</time>. The files rebuild whenever a price changes.</p>}
      <div class="cta-row">
        <a class="btn btn-primary" href="/data/pricing.json" download>Download JSON</a>
        <a class="btn" href="/data/pricing.csv" download>Plans CSV</a>
        <a class="btn" href="/data/scenarios.csv" download>Team-cost CSV</a>
      </div>

      <h2 id="whats-in-it">What is in it</h2>
      <ul>
        <li><strong>Plans.</strong> The price when billed month to month and the effective monthly price when billed yearly, the unit (flat, per seat, per site) and the main limits.</li>
        <li><strong>Add-ons, usage fees and extra costs.</strong> Extra seats, contact tiers, SMS and email rates, transaction fees and one-time onboarding charges.</li>
        <li><strong>Team-size costs.</strong> Our estimate of the real monthly bill at three business sizes: one person, a five-person business and a fifteen-person business. Each tool is sized for the job it does, not for the headcount{crmSmall && seoSmall ? `, so a five-person business counts as ${crmSmall} in a CRM and ${seoSmall} in an SEO tool` : ''}; each scenario's label says what it counts, and <a href="/methodology/#how-we-work-out-the-real-monthly-bill">the methodology</a> has the full table. Every line of the bill is shown, with a confidence level.</li>
        <li><strong>Sources.</strong> The vendor URL each figure came from and the date we read it. Anything we could not confirm is listed separately and never shown as a price.</li>
      </ul>

      <h2 id="what-the-data-shows">What the data shows</h2>
      <p>These figures are computed from the same records as the team-cost CSV, with prices checked between <time datetime={oldest}>{longDate(oldest)}</time> and <time datetime={latest}>{longDate(latest)}</time>. Each tool's cheapest paid plan is taken at its advertised price, which for a per-seat plan means one seat.</p>
      <ul>
        <li>For {above === gaps.length ? <>all <data value={above}>{above}</data></> : <><data value={above}>{above}</data> of the <data value={gaps.length}>{gaps.length}</data></>} tools with a self-serve paid plan, CinchStack's estimate of a small team's real monthly bill is higher than the cheapest plan's advertised price. The median small-team bill is <data value={times(median)}>{times(median)}</data> times that price.</li>
        <li>In <data value={otherPlan}>{otherPlan}</data> of those tools the small-team scenario uses a different plan from the cheapest one. Of the cheapest plans, <data value={perSeat}>{perSeat}</data> are priced per seat, while the small-team bill counts every seat the job needs.</li>
        <li>The gap is widest for {widest.map((g, i) => <>{i > 0 && (i === widest.length - 1 ? ' and ' : ', ')}<a href={toolHref(g.id) ?? `/tools/${g.id}/`}>{tools[g.id].name}</a> (<Fig v={g.c.v} suffix="/mo" /> to <Fig v={g.sm.monthly} suffix="/mo" floor={g.sm.floor} />, <data value={times(g.ratio)}>{times(g.ratio)}</data> times)</>)}, and narrowest for {narrowest.map((g, i) => <>{i > 0 && (i === narrowest.length - 1 ? ' and ' : ', ')}<a href={toolHref(g.id) ?? `/tools/${g.id}/`}>{tools[g.id].name}</a> (<Fig v={g.c.v} suffix="/mo" /> to <Fig v={g.sm.monthly} suffix="/mo" floor={g.sm.floor} />, <data value={times(g.ratio)}>{times(g.ratio)}</data> times)</>)}. {wideNote}Each tool's pricing page shows what its small-team bill counts.</li>
        <li><data value={metered}>{metered}</data> of the <data value={toolIds.length}>{toolIds.length}</data> tools bill some usage per unit on top of the subscription, <data value={withAddOns}>{withAddOns}</data> sell paid add-ons, and <data value={freePlans}>{freePlans}</data> offer a free plan.</li>
      </ul>

      <h2 id="how-to-cite">How to cite this data</h2>
      <p>You may copy, share and adapt the dataset for any purpose, including commercial use, under the <a href={LICENSE} rel="license noopener">Creative Commons Attribution 4.0 license</a>. Please credit us and link back:</p>
      <blockquote class="callout mono small">{CITATION}</blockquote>
      <p>On a web page, this HTML credit line is ready to paste:</p>
      <pre class="callout mono small" style="white-space:pre-wrap;overflow-wrap:anywhere"><code>{snippet}</code></pre>
      <p>If you quote a single price, link to that tool's pricing page on this site so readers can see the check date. Prices change; a figure is only as good as the date beside it.</p>

      <h2 id="fields">Field notes</h2>
      <ul>
        <li>All money is US dollars, as shown to a US buyer. Where a vendor prices by country, the tool's page says so.</li>
        <li><code>monthly</code> is null when a plan is sold only on a yearly contract. <code>annualMonthly</code> is null when there is no yearly option.</li>
        <li>Team-size costs use the assumptions written into each scenario. They are estimates for comparison, not quotes.</li>
        <li>Card processing fees on e-commerce tools are listed as extra costs and are not added into the monthly totals.</li>
      </ul>
    </div>

    <section class="section">
      <h2 id="tools">Tools in the dataset</h2>
      <p class="table-lead">Every tool in the files, with its cheapest paid plan (the month-to-month price where one is offered) and the date we last read its pricing page.</p>
      <div class="tbl-wrap" tabindex="0" role="region" aria-label="Tools in the dataset with their cheapest paid plan">
        <table class="data stack">
          <thead><tr><th scope="col">Tool</th><th scope="col">Layer</th><th scope="col" class="num">Plans</th><th scope="col" class="num">Cheapest paid plan</th><th scope="col">Checked</th></tr></thead>
          <tbody>
            {toolIds.map((id) => { const c = cheapestPaid(id); return (
              <tr>
                <th scope="row" data-label="Tool">{toolHref(id) ? <a href={toolHref(id)}>{tools[id].name}</a> : tools[id].name}</th>
                <td data-label="Layer">{LAYER_LABELS[tools[id].layer]}</td>
                <td data-label="Plans" class="num">{pricing[id].plans.length}</td>
                <td data-label="Cheapest paid" class="num">{c ? <><Fig v={c.v} suffix="/mo" /> <span class="sub">{c.p.name}</span></> : <>{noPaidPlan(id).value} <span class="sub">{noPaidPlan(id).sub}</span></>}</td>
                <td data-label="Checked"><time datetime={pricing[id].checkedOn}>{longDate(pricing[id].checkedOn)}</time></td>
              </tr>
            ); })}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</Base>
