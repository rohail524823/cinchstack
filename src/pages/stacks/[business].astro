---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { SITE } from '../../lib/site.mjs';
import { tool, price, stacks, stackBill, faqs, scenario } from '../../lib/data.mjs';
import { LAYER_LABELS } from '../../lib/schemas.mjs';
import { registry, relatedFor, lowerFirst } from '../../lib/pages.mjs';
import { datesFor } from '../../lib/meta.mjs';
import { breadcrumbNode, articleNode, itemListNode, faqNode } from '../../lib/jsonld.mjs';
import { mdxComponents } from '../../components/mdx/index.mjs';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Byline from '../../components/Byline.astro';
import Disclosure from '../../components/Disclosure.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import StackBill from '../../components/StackBill.astro';
import AffLink from '../../components/AffLink.astro';
import Provenance from '../../components/Provenance.astro';
import Faq from '../../components/Faq.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import ServiceBox from '../../components/ServiceBox.astro';
import KeepReading from '../../components/KeepReading.astro';
import Updated from '../../components/Updated.astro';
import Fig from '../../components/Fig.astro';

export async function getStaticPaths() {
  const reg = await registry();
  return [...reg.values()].filter((r) => r.kind === 'stacks').map((r) => ({ params: { business: r.slug }, props: { r } }));
}
const { r } = Astro.props;
const s = stacks[r.slug];
const e = r.entry;
const path = `/stacks/${s.id}/`;
const url = `${SITE}${path}`;
const { Content } = await render(e);
const faq = faqs[`stacks--${s.id}`]?.items ?? [];
const d = datesFor(e);
const bill = stackBill(s.id);
const all = [...new Set([...s.layers.map((l) => l.pick), ...s.layers.flatMap((l) => l.alternatives.map((a) => a.tool))])];
const verified = s.layers.map((l) => price(l.pick).checkedOn).sort()[0];
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Stacks', href: '/stacks/' }, { label: s.label }];
const related = await relatedFor(e.id, e.data.related);
// A layer whose pick is already paid for elsewhere in the stack (override of 0 at every size) needs no second button.
const includedEverywhere = (i) => ['solo', 'small', 'growing'].every((z) => bill.rows[i].cells[z].override && bill.rows[i].cells[z].amount === 0);
const reg = await registry();
const best = (x) => (reg.has(`/tools/${x}/pricing/`) ? `/tools/${x}/pricing/` : reg.has(`/tools/${x}/`) ? `/tools/${x}/` : null);
const jsonld = [
  breadcrumbNode(url, crumbs),
  articleNode({ url, headline: e.data.title, description: e.data.description, published: d.published, modified: d.modified }),
  itemListNode(url, `Software stack for a ${lowerFirst(s.label)}`, s.layers.map((l) => ({ name: tool(l.pick).name, url: `${SITE}${best(l.pick) ?? path}` }))),
  faqNode(url, faq),
];
---
<Base title={e.data.title} description={e.data.description} path={path} jsonld={jsonld}>
  <div class="wrap page">
    <article class="read" style="max-width:920px">
      <Breadcrumbs crumbs={crumbs} />
      <h1>{r.h1}</h1>
      <Byline modified={d.modified} published={d.published} verified={verified} ids={[...new Set(s.layers.map((l) => l.pick))]} />
      <Disclosure toolIds={s.layers.map((l) => l.pick)} page={path} />
      {e.data.quickAnswer && <QuickAnswer text={e.data.quickAnswer} />}
      <p class="lede" data-prose>{s.profile}</p>
      <h2 id="total-cost">What the whole stack costs</h2>
      <StackBill id={s.id} />
      {s.layers.map((l, i) => (<>
        <h2 id={`layer-${l.layer}-${l.pick}`}>{LAYER_LABELS[l.layer]}: {l.role}</h2>
        <div class="picks">
          <div class="pick">
            <span class="lbl">Our pick</span>
            <h3>{tool(l.pick).name}</h3>
            <p data-prose>{l.why}</p>
            {(() => { const cell = bill.rows[i].cells.small; return cell.override
              ? <p class="small">{s.sizeLabels.small}: {cell.amount === 0 ? cell.note : <><Fig v={cell.amount} suffix="/mo" floor={cell.floor} /> <span class="muted">({cell.note})</span></>}</p>
              : <p class="small">{s.sizeLabels.small}: <Fig v={cell.amount} suffix="/mo" floor={cell.floor} />{best(l.pick) && <> · <a href={best(l.pick)}>real cost</a></>}</p>; })()}
            {!includedEverywhere(i) && <AffLink tool={l.pick} page={path} placement={`stack-${l.layer}`} label={`Visit ${tool(l.pick).name}`} />}
          </div>
          {l.alternatives.length > 0 && (
            <div class="pick">
              <span class="lbl">Pick something else when…</span>
              <ul data-prose>{l.alternatives.map((a) => <li>{best(a.tool) ? <a href={best(a.tool)}>{tool(a.tool).name}</a> : tool(a.tool).name}: {a.when}</li>)}</ul>
            </div>
          )}
        </div>
      </>))}
      {s.extras.length > 0 && (<>
        <h2 id="free-extras">Free tools we would add</h2>
        <ul data-prose>{s.extras.map((x) => <li><a href={x.url} rel="noopener" target="_blank">{x.name}</a>: {x.note}</li>)}</ul>
      </>)}
      {s.skip.length > 0 && (<>
        <h2 id="skip">What to skip</h2>
        <ul data-prose>{s.skip.map((x) => <li><strong>{x.what}.</strong> {x.why}</li>)}</ul>
      </>)}
      <div class="prose-body" data-prose>
        <Content components={mdxComponents} />
      </div>
      <Provenance ids={s.layers.map((l) => l.pick)} />
      <Faq items={faq} />
      <ServiceBox scope="stack" />
      <AuthorBox />
      <KeepReading links={related} />
      <Updated modified={d.modified} published={d.published} />
    </article>
  </div>
</Base>
