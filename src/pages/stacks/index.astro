---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../lib/site.mjs';
import { stacks, stackBill, tool } from '../../lib/data.mjs';
import { registry } from '../../lib/pages.mjs';
import { breadcrumbNode, itemListNode, webPageNode } from '../../lib/jsonld.mjs';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Fig from '../../components/Fig.astro';
const reg = await registry();
const live = Object.values(stacks).filter((s) => reg.has(`/stacks/${s.id}/`));
const path = '/stacks/';
const url = `${SITE}${path}`;
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Stacks' }];
const title = 'The best software stack for your kind of business';
const description = 'Recommended software stacks for agencies, course creators, online stores, local services, freelancers and SaaS startups, with the total monthly bill.';
---
<Base title={title} description={description} path={path} jsonld={[breadcrumbNode(url, crumbs), webPageNode({ url, name: title, description, type: 'CollectionPage' }), itemListNode(url, 'Stacks', live.map((s) => ({ name: reg.get(`/stacks/${s.id}/`).h1, url: `${SITE}/stacks/${s.id}/` })))]}>
  <div class="wrap page">
    <Breadcrumbs crumbs={crumbs} />
    <h1>The stack that's best for you</h1>
    <p class="lede">Pick the business closest to yours. Each stack names one tool per job, says when to choose something else, and adds up the whole monthly bill at three sizes.</p>
    <div class="grid" style="margin-top:22px">
      {live.map((s) => { const b = stackBill(s.id); return (
        <a class="card" href={`/stacks/${s.id}/`}>
          <span class="tag">Stack</span>
          <h3>{s.label}</h3>
          <p>{s.layers.map((l) => tool(l.pick).name).join(' · ')}</p>
          <p class="cost">{s.sizeLabels.small}: <Fig v={b.totals.small} suffix="/mo" /></p>
        </a>
      ); })}
    </div>
  </div>
</Base>
