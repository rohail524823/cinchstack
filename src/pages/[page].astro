---
// Trust and utility pages written as MDX in src/content/pages/.
import Base from '../layouts/Base.astro';
import { render } from 'astro:content';
import { SITE, AUTHOR_ID } from '../lib/site.mjs';
import { registry } from '../lib/pages.mjs';
import { datesFor } from '../lib/meta.mjs';
import { breadcrumbNode, webPageNode } from '../lib/jsonld.mjs';
import { mdxComponents } from '../components/mdx/index.mjs';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Updated from '../components/Updated.astro';
import AuthorBox from '../components/AuthorBox.astro';
import Programs from '../components/trust/Programs.astro';
import Mandated from '../components/trust/Mandated.astro';
import ContactForm from '../components/trust/ContactForm.astro';
import Factors from '../components/trust/Factors.astro';
import Coverage from '../components/trust/Coverage.astro';
import Analytics from '../components/trust/Analytics.astro';
import Packages from '../components/trust/Packages.astro';
import ServicesForm from '../components/trust/ServicesForm.astro';
import AlertsPrivacy from '../components/trust/AlertsPrivacy.astro';
import { services } from '../lib/data.mjs';

export async function getStaticPaths() {
  const reg = await registry();
  return [...reg.values()].filter((r) => r.kind === 'pages').map((r) => ({ params: { page: r.slug }, props: { r } }));
}
const { r } = Astro.props;
const e = r.entry;
const slug = r.slug;
const path = `/${slug}/`;
const url = `${SITE}${path}`;
const { Content } = await render(e);
const d = datesFor(e);
const NOINDEX = new Set(['thanks']);
const TYPE = { about: 'AboutPage', contact: 'ContactPage', methodology: 'WebPage', 'how-we-earn': 'WebPage' };
const crumbs = [{ label: 'Home', href: '/' }, { label: r.h1 }];
// /about/ is also the author page: one node typed AboutPage and ProfilePage, whose main entity is
// the Person node already in the graph.
const page = webPageNode({ url, name: e.data.title, description: e.data.description, type: slug === 'about' ? ['AboutPage', 'ProfilePage'] : TYPE[slug] ?? 'WebPage' });
page.datePublished = d.published;
page.dateModified = d.modified;
if (slug === 'about') Object.assign(page, { mainEntity: { '@id': AUTHOR_ID }, dateCreated: d.published });
const extra = [];
if (slug === 'services') {
  // One Service node per package, offered by the editor (the Person node already in the graph).
  for (const p of services.packages) {
    extra.push({
      '@type': 'Service', '@id': `${url}#pkg-${p.id}`, name: p.name, description: p.for, serviceType: p.kind,
      provider: { '@id': AUTHOR_ID }, areaServed: 'Worldwide', url: `${url}#pkg-${p.id}`,
      offers: { '@type': 'Offer', priceCurrency: 'USD', ...(p.from ? { priceSpecification: { '@type': 'PriceSpecification', minPrice: p.price, priceCurrency: 'USD' } } : { price: p.price }) },
    });
  }
}
const components = { ...mdxComponents, Programs, Mandated, ContactForm, Factors, Coverage, Analytics, Packages, ServicesForm, AlertsPrivacy };
---
<Base title={e.data.title} description={e.data.description} path={path} noindex={NOINDEX.has(slug)} ogType="website" jsonld={[breadcrumbNode(url, crumbs), page, ...extra]}>
  <div class="wrap page">
    <article class="read">
      <Breadcrumbs crumbs={crumbs} />
      <h1>{r.h1}</h1>
      <div class="prose-body"><Content components={components} /></div>
      {slug === 'about' && <AuthorBox />}
      {!NOINDEX.has(slug) && <Updated published={d.published} modified={d.modified} />}
    </article>
  </div>
</Base>
