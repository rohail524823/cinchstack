---
import Base from '../../../layouts/Base.astro';
import { render } from 'astro:content';
import { SITE } from '../../../lib/site.mjs';
import { tool, price, scenario, cheapestPaid, noPaidPlan, faqs, sizeBasis, paysUsOn, program, trialOffer } from '../../../lib/data.mjs';
import { registry, relatedFor, exists } from '../../../lib/pages.mjs';
import { datesFor } from '../../../lib/meta.mjs';
import { figHtml, poss } from '../../../lib/format.mjs';
import { breadcrumbNode, articleNode, webPageNode, softwareNode, faqNode } from '../../../lib/jsonld.mjs';
import { mdxComponents } from '../../../components/mdx/index.mjs';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Byline from '../../../components/Byline.astro';
import Disclosure from '../../../components/Disclosure.astro';
import QuickAnswer from '../../../components/QuickAnswer.astro';
import Glance from '../../../components/Glance.astro';
import AffLink from '../../../components/AffLink.astro';
import PlansTable from '../../../components/PlansTable.astro';
import ScenarioBill from '../../../components/ScenarioBill.astro';
import CostsTable from '../../../components/CostsTable.astro';
import Provenance from '../../../components/Provenance.astro';
import Faq from '../../../components/Faq.astro';
import AuthorBox from '../../../components/AuthorBox.astro';
import ServiceBox from '../../../components/ServiceBox.astro';
import KeepReading from '../../../components/KeepReading.astro';
import ToolLinks from '../../../components/ToolLinks.astro';
import Updated from '../../../components/Updated.astro';
import AlertsCta from '../../../components/AlertsCta.astro';

export async function getStaticPaths() {
  const reg = await registry();
  return [...reg.values()].filter((r) => r.kind === 'pricing').map((r) => ({ params: { tool: r.slug }, props: { r } }));
}
const { r } = Astro.props;
const id = r.slug;
const t = tool(id);
const p = price(id);
const e = r.entry;
const path = `/tools/${id}/pricing/`;
const url = `${SITE}${path}`;
const { Content } = await render(e);
const faq = faqs[`pricing--${id}`]?.items ?? [];
const d = datesFor(e);
const cheapest = cheapestPaid(id);
const small = scenario(id, 'small');
const hubExists = await exists(`/tools/${id}/`);
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools/' }, { label: t.name, href: hubExists ? `/tools/${id}/` : undefined }, { label: 'Pricing' }];
const related = await relatedFor(e.id, e.data.related);
const jsonld = [
  breadcrumbNode(url, crumbs),
  articleNode({ url, headline: e.data.title, description: e.data.description, published: d.published, modified: d.modified }),
  webPageNode({ url, name: e.data.title, description: e.data.description, lastReviewed: p.checkedOn }),
  softwareNode(id),
  faqNode(url, faq),
];
// A trial the program authorized in writing (HighLevel's 30-day Bootcamp trial) replaces the closing button.
const offer = trialOffer(id, path);
const quietTrial = !offer && paysUsOn(id, path) && Boolean(program(id)?.rules?.noUnauthorizedOffers);
const glance = [
  { label: 'Cheapest paid plan', value: cheapest ? `${figHtml(cheapest.v, '/mo')} <span class="sub" style="font-weight:400;color:var(--mute);font-size:14px">${cheapest.p.name}</span>` : `${noPaidPlan(id).value} <span class="sub" style="font-weight:400;color:var(--mute);font-size:14px">${noPaidPlan(id).sub}</span>` },
  { label: 'Free plan', value: p.freeTier.exists ? 'Yes' : 'No' },
  // Programs with noUnauthorizedOffers bar trial wording beside their paid links unless they authorized it in writing.
  ...(quietTrial ? [] : [{ label: 'Free trial', value: offer ? `${offer.days} days <span class="sub" style="font-weight:400;color:var(--mute);font-size:14px">through the trial link at the end of this page; ${p.trial.days} on ${poss(t.name)} pricing page</span>` : p.trial.days ? `${p.trial.days} days${p.trial.cardRequired ? ' (card needed)' : ''}` : 'No' }]),
  { label: 'Real bill, small team', value: `${figHtml(small.monthly, '/mo', small.floor)} <span class="sub" style="font-weight:400;color:var(--mute);font-size:14px">${sizeBasis(id, 'small')}</span>` },
];
---
<Base title={e.data.title} description={e.data.description} path={path} jsonld={jsonld}>
  <div class="wrap page">
    <article class="read" style="max-width:860px">
      <Breadcrumbs crumbs={crumbs} />
      <h1>{r.h1}</h1>
      <Byline modified={d.modified} published={d.published} verified={p.checkedOn} ids={[id]} />
      <Disclosure toolIds={[id]} page={path} />
      {e.data.quickAnswer && <QuickAnswer text={e.data.quickAnswer} />}
      <Glance items={glance} />
      <div class="cta-row">
        <AffLink tool={id} href={t.pricingUrl} page={path} placement="top-pricing" label={`Compare plans on ${poss(t.name)} own site`} />
        <span class="note">Opens {new URL(t.pricingUrl).hostname.replace(/^www\./, '')}</span>
      </div>
      <h2 id="plans">{t.name} plans and prices</h2>
      <PlansTable id={id} />
      <h2 id="real-cost">What you will really pay</h2>
      <ScenarioBill id={id} />
      <div class="prose-body" data-prose>
        <Content components={mdxComponents} />
      </div>
      {(p.addOns.length + p.usage.length + p.extraCosts.length) > 0 && (<>
        <h2 id="extra-costs">Add-ons, usage and other costs</h2>
        <CostsTable id={id} />
      </>)}
      {p.billingNotes.length > 0 && (<>
        <h2 id="billing">Billing rules worth knowing</h2>
        <ul>{p.billingNotes.map((n) => <li>{n}</li>)}</ul>
      </>)}
      <ToolLinks id={id} block="guides" />
      <ToolLinks id={id} block="compare" />
      <Provenance ids={[id]} />
      <AlertsCta place="pricing" />
      <div class="cta-row">
        {offer ? (<>
          <AffLink tool={id} href={offer.href} page={path} placement="end-trial" label={offer.label} />
          <p class="offer-note">{offer.note}</p>
        </>) : (<>
          <AffLink tool={id} href={t.pricingUrl} page={path} placement="end-cta" label={`See ${poss(t.name)} plans and prices`} />
          {p.trial.days && !quietTrial ? <span class="note">{t.name} offers a {p.trial.days}-day trial{p.trial.cardRequired === false ? ' with no card required' : ''}.</span> : null}
        </>)}
      </div>
      <Faq items={faq} />
      <ServiceBox scope="tool" ids={[id]} />
      <AuthorBox />
      <KeepReading links={related} />
      <Updated modified={d.modified} published={d.published} />
    </article>
  </div>
</Base>
