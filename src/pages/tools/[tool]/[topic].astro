---
// Cost guides for one tool: /tools/<tool>/<topic>/, written as src/content/guides/<tool>--<topic>.mdx.
// Every figure comes from the tool's pricing record (tokens, or the data-driven UsageMatrix).
import Base from '../../../layouts/Base.astro';
import { render } from 'astro:content';
import { SITE } from '../../../lib/site.mjs';
import { tool, price, faqs } from '../../../lib/data.mjs';
import { registry, relatedFor, exists, guideParts } from '../../../lib/pages.mjs';
import { datesFor } from '../../../lib/meta.mjs';
import { poss } from '../../../lib/format.mjs';
import { breadcrumbNode, articleNode, webPageNode, faqNode } from '../../../lib/jsonld.mjs';
import { mdxComponents } from '../../../components/mdx/index.mjs';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Byline from '../../../components/Byline.astro';
import Disclosure from '../../../components/Disclosure.astro';
import QuickAnswer from '../../../components/QuickAnswer.astro';
import AffLink from '../../../components/AffLink.astro';
import Provenance from '../../../components/Provenance.astro';
import Faq from '../../../components/Faq.astro';
import AuthorBox from '../../../components/AuthorBox.astro';
import ServiceBox from '../../../components/ServiceBox.astro';
import KeepReading from '../../../components/KeepReading.astro';
import Updated from '../../../components/Updated.astro';

export async function getStaticPaths() {
  const reg = await registry();
  return [...reg.values()].filter((r) => r.kind === 'guides').map((r) => {
    const [t, topic] = guideParts(r.slug);
    return { params: { tool: t, topic }, props: { r } };
  });
}
const { r } = Astro.props;
const [id, topic] = guideParts(r.slug);
const t = tool(id);
const p = price(id);
const e = r.entry;
const path = `/tools/${id}/${topic}/`;
const url = `${SITE}${path}`;
const { Content } = await render(e);
const faq = faqs[`guides--${r.slug}`]?.items ?? [];
const d = datesFor(e);
const hubExists = await exists(`/tools/${id}/`);
const pricingExists = await exists(`/tools/${id}/pricing/`);
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools/' }, { label: t.name, href: hubExists ? `/tools/${id}/` : pricingExists ? `/tools/${id}/pricing/` : undefined }, { label: r.h1 }];
const related = await relatedFor(e.id, e.data.related);
const jsonld = [
  breadcrumbNode(url, crumbs),
  articleNode({ url, headline: e.data.title, description: e.data.description, published: d.published, modified: d.modified }),
  webPageNode({ url, name: e.data.title, description: e.data.description, lastReviewed: p.checkedOn }),
  faqNode(url, faq),
];
---
<Base title={e.data.title} description={e.data.description} path={path} jsonld={jsonld}>
  <div class="wrap page">
    <article class="read" style="max-width:860px">
      <Breadcrumbs crumbs={crumbs} />
      <h1>{r.h1}</h1>
      <Byline modified={d.modified} published={d.published} verified={p.checkedOn} ids={[id]} />
      <Disclosure toolIds={[id]} page={path} />
      {e.data.quickAnswer && <QuickAnswer text={e.data.quickAnswer} />}
      <div class="prose-body" data-prose>
        <Content components={mdxComponents} />
      </div>
      <div class="cta-row">
        <AffLink tool={id} href={t.pricingUrl} page={path} placement="guide-end" label={`See ${poss(t.name)} plans and prices`} />
        {pricingExists && <a class="btn" href={`/tools/${id}/pricing/`}>Every {t.name} price, line by line</a>}
      </div>
      <Provenance ids={[id]} />
      <Faq items={faq} />
      <ServiceBox scope="tool" ids={[id]} />
      <AuthorBox />
      <KeepReading links={related} />
      <Updated modified={d.modified} published={d.published} />
    </article>
  </div>
</Base>
