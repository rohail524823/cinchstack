---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../lib/site.mjs';
import { comparisons, tool } from '../../lib/data.mjs';
import { LAYERS, LAYER_LABELS } from '../../lib/schemas.mjs';
import { registry } from '../../lib/pages.mjs';
import { breadcrumbNode, itemListNode, webPageNode } from '../../lib/jsonld.mjs';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
const reg = await registry();
const live = Object.values(comparisons).filter((c) => reg.has(`/compare/${c.id}/`));
const path = '/compare/';
const url = `${SITE}${path}`;
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Compare' }];
const title = 'Software comparisons built on real prices';
const description = 'Head-to-head comparisons of small-business software, built from verified pricing at three team sizes, with a verdict for each kind of business.';
---
<Base title={title} description={description} path={path} jsonld={[breadcrumbNode(url, crumbs), webPageNode({ url, name: title, description, type: 'CollectionPage' }), itemListNode(url, 'Comparisons', live.map((c) => ({ name: reg.get(`/compare/${c.id}/`).h1, url: `${SITE}/compare/${c.id}/` })))]}>
  <div class="wrap page">
    <Breadcrumbs crumbs={crumbs} />
    <h1>Comparisons</h1>
    <p class="lede">Two tools, the same assumptions, the real bill at three sizes — and which one we would pick for each kind of business.</p>
    <h2>How these comparisons work</h2>
    <p class="muted read">Each comparison prices both tools for the same businesses at three team sizes, using the plan each business would actually need rather than the cheapest plan on the page. The {live.length} comparisons below are grouped by the job the tools do, and each page shows the date its prices were last checked.</p>
    {LAYERS.map((l) => { const cs = live.filter((c) => c.layer === l); return cs.length > 0 && (
      <section class="section">
        <h2 id={l}>{LAYER_LABELS[l]}</h2>
        <div class="grid">{cs.map((c) => <a class="card" href={`/compare/${c.id}/`}><span class="tag">{LAYER_LABELS[l]}</span><h3>{tool(c.a).name} vs {tool(c.b).name}</h3><p>{reg.get(`/compare/${c.id}/`).title}</p></a>)}</div>
      </section>
    ); })}
  </div>
</Base>
