---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site.mjs';
import { stacks, stackBill, tool, tools, coreToolIds, comparisons, changelog, pricing, checks, scenario, cheapestPaid, services, sizeBasis } from '../lib/data.mjs';
import { registry, pathFor } from '../lib/pages.mjs';
import { longDate } from '../lib/format.mjs';
import { LAYER_LABELS } from '../lib/schemas.mjs';
import { itemListNode, webPageNode } from '../lib/jsonld.mjs';
import ToolCard from '../components/ToolCard.astro';
import Fig from '../components/Fig.astro';

const reg = await registry();
// The three businesses both of the site's earners serve (the programs that pay us and the setup
// work) lead; the other stacks stay one click away.
const LEAD = ['agency', 'local-service', 'course-creator'];
const liveStacks = Object.values(stacks).filter((s) => reg.has(`/stacks/${s.id}/`));
const leadStacks = LEAD.map((id) => stacks[id]).filter((s) => s && reg.has(`/stacks/${s.id}/`));
const otherStacks = liveStacks.filter((s) => !LEAD.includes(s.id));
const toolHref = (id) => (reg.has(`/tools/${id}/pricing/`) ? `/tools/${id}/pricing/` : reg.has(`/tools/${id}/`) ? `/tools/${id}/` : null);
const liveCore = coreToolIds.filter((id) => toolHref(id));
const guides = [...reg.values()].filter((r) => r.kind === 'guides').map((r) => ({ path: pathFor(r.id), h1: r.h1 }));
// Comparisons that involve the core tools first.
const coreSet = new Set(coreToolIds);
const liveCompare = Object.values(comparisons).filter((c) => reg.has(`/compare/${c.id}/`))
  .sort((x, y) => (coreSet.has(y.a) + coreSet.has(y.b)) - (coreSet.has(x.a) + coreSet.has(x.b))).slice(0, 8);
const realChanges = changelog.filter((c) => c.kind !== 'initial-record').slice(0, 5);
const toolsTracked = Object.keys(pricing).length;
// Every price was last recorded on or after the oldest record date; say that, not the newest one.
const latest = Object.values(pricing).map((p) => p.checkedOn).sort()[0];
// The weekly script re-reads every vendor page it can; its date is fresher than the last manual record.
const passed = Object.values(checks).filter((c) => c.status === 'passed');
const lastRun = passed.map((c) => c.ranOn).sort().at(-1);
const proof = stackBill('agency');
// Override cells can carry a plan price that leaves metered usage out (GoHighLevel here); say so.
const usageOut = proof.rows.filter((r) => r.cells.small.override && /extra/i.test(r.cells.small.note ?? ''));
const proofFloor = proof.floors.small || usageOut.length > 0;
const proofStack = stacks.agency;
// Sticker price against the real bill: the gap is the point of the site.
const gaps = ['gohighlevel', 'systeme-io', 'hubspot'].filter((id) => toolHref(id)).map((id) => ({ id, entry: cheapestPaid(id), small: scenario(id, 'small') }));
const path = '/';
const url = `${SITE}/`;
const title = 'What CRM, funnel and course software really costs | CinchStack';
const description = 'Real monthly costs of GoHighLevel, Systeme.io, HubSpot and the tools they get compared with, read from vendor pricing pages, dated, with a weekly re-read.';
const ld = [
  webPageNode({ url, name: title, description, lastReviewed: latest }),
  liveStacks.length ? itemListNode(url, 'Software stacks by business', liveStacks.map((s) => ({ name: reg.get(`/stacks/${s.id}/`).h1, url: `${SITE}/stacks/${s.id}/` }))) : null,
];
---
<Base title={title} description={description} path={path} ogType="website" jsonld={ld}>
  <div class="wrap">
    <section class="hero hero-grid">
      <div>
        <p class="lbl">For agencies, local businesses and course creators</p>
        <h1>Know what your software will really cost before you sign up.</h1>
        <p class="lede">The plan price is only the start. We add up the whole monthly bill, with the seats, texts, contacts and add-ons you will actually need, from each vendor's own pricing page, and a script re-reads those pages every Monday.</p>
        <nav class="chips" aria-label="Pick your business">
          <span class="chips-q">I run a…</span>
          {leadStacks.map((s) => <a class="chip" href={`/stacks/${s.id}/`}>{s.label}</a>)}
        </nav>
        {otherStacks.length > 0 && <p class="small muted">Also: {otherStacks.map((s, i) => <>{i > 0 && ' · '}<a href={`/stacks/${s.id}/`}>{s.label}</a></>)}</p>}
        {latest && <p class="muted small">{toolsTracked} tools tracked · every price recorded since <time datetime={latest}>{longDate(latest)}</time>{lastRun && <> · pages for {passed.length} tools re-read automatically on <time datetime={lastRun}>{longDate(lastRun)}</time></>}</p>}
      </div>
      <aside class="proof card" aria-label="Example monthly bill">
        <span class="lbl">Real bill: {proofStack.sizeLabels.small.toLowerCase()}</span>
        <p class="proof-total"><Fig v={proof.totals.small} suffix="/mo" floor={proofFloor} /></p>
        <ul class="proof-lines">
          {proof.rows.map((r) => <li><span>{tool(r.pick).name} <span class="muted">· {LAYER_LABELS[r.layer]}</span></span><Fig v={r.cells.small.amount} floor={r.cells.small.floor} /></li>)}
        </ul>
        {usageOut.length > 0 && <p class="small muted">{usageOut.map((r) => tool(r.pick).name).join(', ')}: plan price only; its metered texts, calls and email come on top.</p>}
        <a href="/stacks/agency/">See the whole agency stack, line by line →</a>
      </aside>
    </section>

    {gaps.length > 0 && (
      <section class="section" aria-labelledby="gap">
        <h2 id="gap">Sticker price against the real bill</h2>
        <p class="muted">Each vendor's cheapest paid plan, next to what a small team pays once the plan, seats, usage and add-ons it needs are counted. The basis of each bill is under it.</p>
        <div class="grid-3">
          {gaps.map((g) => (
            <a class="card" href={toolHref(g.id)}>
              <span class="tag">{LAYER_LABELS[tool(g.id).layer]} · {tool(g.id).category}</span>
              <h3>{tool(g.id).name}</h3>
              <p>List price from {g.entry ? <><Fig v={g.entry.v} suffix="/mo" />{/per-seat/.test(g.entry.p.priceUnit) ? ' per seat' : ''} ({g.entry.p.name})</> : 'free'}</p>
              <p class="cost">Real bill, small team: <Fig v={g.small.monthly} suffix="/mo" floor={g.small.floor} /></p>
              <p class="small muted">{g.small.label}</p>
              <p class="small">See every plan, add-on and usage fee →</p>
            </a>
          ))}
        </div>
      </section>
    )}

    {guides.length > 0 && (
      <section class="section" aria-labelledby="guides">
        <h2 id="guides">Cost guides</h2>
        <p class="muted">The costs a pricing page leaves out, worked through from each vendor's own published rates.</p>
        <ul class="related-list">
          {guides.map((g) => <li><a href={g.path}>{g.h1}</a></li>)}
        </ul>
      </section>
    )}

    {liveCore.length > 0 && (
      <section class="section" aria-labelledby="tools">
        <h2 id="tools">The tools we cover most closely</h2>
        <p class="muted">CRMs, funnel builders, course platforms and email tools. Each card shows the real monthly bill for a small team, sized for the job the tool does.</p>
        <div class="grid">{liveCore.map((id) => <ToolCard id={id} href={toolHref(id)} />)}</div>
        <p><a href="/tools/">See all {toolsTracked} tools we track</a></p>
      </section>
    )}

    {liveCompare.length > 0 && (
      <section class="section" aria-labelledby="compare">
        <h2 id="compare">Head-to-head comparisons</h2>
        <ul class="related-list">
          {liveCompare.map((c) => <li><a href={`/compare/${c.id}/`}>{tools[c.a].name} vs {tools[c.b].name}</a></li>)}
        </ul>
        <p><a href="/compare/">All comparisons</a></p>
      </section>
    )}

    {realChanges.length > 0 && (
      <section class="section" aria-labelledby="changes">
        <h2 id="changes">Latest price changes</h2>
        <ul class="changes-list">
          {realChanges.map((c) => <li><time datetime={c.date}>{longDate(c.date)}</time><div><strong>{toolHref(c.tool) ? <a href={toolHref(c.tool)}>{tool(c.tool).name}</a> : tool(c.tool).name}:</strong> {c.summary}</div></li>)}
        </ul>
        <p><a href="/changes/">Every recorded change</a></p>
      </section>
    )}

    <section class="section" aria-labelledby="setup">
      <div class="svc-box svc-home" data-svc>
        <p class="lbl">Our own paid service</p>
        <h2 id="setup">Want it set up for you?</h2>
        <p>CinchStack's editor, Rohail Nisar, sets up CRMs, moves contacts, builds automations and AI assistants for small businesses, at the same price whichever tool you choose. Packages start at <Fig v={Math.min(...services.packages.map((p) => p.price))} />, after a free 30-minute call. It is separate from our reviews.</p>
        <p><a class="btn" href="/services/">See the setup packages</a></p>
      </div>
    </section>

    <section class="section read" aria-labelledby="verify">
      <h2 id="verify">How we check a price</h2>
      <p>We open the vendor's pricing page, save a copy of what it says, and record each plan, add-on and usage fee with the date. Every monthly bill on this site is worked out from those records for a stated team size, so you can see exactly what is counted. A script re-reads the pages every Monday, and any change is logged publicly. <a href="/methodology/">Read the full method</a>.</p>
      <p>Some links on this site may earn us a commission. Commissions are kept out of how prices are recorded, how scores are set and how picks are chosen: a tool that pays us gets the lower of its two AI scores, its paid links are labeled, and on alternatives pages it appears beside the highest-scored option, never ahead of it. <a href="/how-we-earn/">Every program we have joined is listed here</a>.</p>
    </section>
  </div>
</Base>
