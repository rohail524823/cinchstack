---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { SITE } from '../../lib/site.mjs';
import { tool, price, scenario, score, alternatives, faqs } from '../../lib/data.mjs';
import { LAYER_LABELS } from '../../lib/schemas.mjs';
import { registry, relatedFor } from '../../lib/pages.mjs';
import { datesFor } from '../../lib/meta.mjs';
import { oneDecimal, slugify } from '../../lib/format.mjs';
import { breadcrumbNode, articleNode, itemListNode, faqNode } from '../../lib/jsonld.mjs';
import { mdxComponents } from '../../components/mdx/index.mjs';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Byline from '../../components/Byline.astro';
import Disclosure from '../../components/Disclosure.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import AffLink from '../../components/AffLink.astro';
import PickCards from '../../components/PickCards.astro';
import Provenance from '../../components/Provenance.astro';
import Faq from '../../components/Faq.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import KeepReading from '../../components/KeepReading.astro';
import Updated from '../../components/Updated.astro';
import Fig from '../../components/Fig.astro';

export async function getStaticPaths() {
  const reg = await registry();
  return [...reg.values()].filter((r) => r.kind === 'alternatives').map((r) => ({ params: { tool: r.slug }, props: { r } }));
}
const { r } = Astro.props;
const id = r.slug;
const t = tool(id);
const alt = alternatives[id];
const e = r.entry;
const path = `/alternatives/${id}/`;
const url = `${SITE}${path}`;
const { Content } = await render(e);
const faq = faqs[`alternatives--${id}`]?.items ?? [];
const d = datesFor(e);
const picks = [...new Set(alt.reasons.flatMap((x) => x.picks.map((p) => p.tool)))];
const verified = [id, ...picks].map((x) => price(x).checkedOn).sort()[0];
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools/' }, { label: `${t.name} alternatives` }];
const related = await relatedFor(e.id, e.data.related);
const reg = await registry();
const best = (x) => (reg.has(`/tools/${x}/pricing/`) ? `/tools/${x}/pricing/` : reg.has(`/tools/${x}/`) ? `/tools/${x}/` : null);
const jsonld = [
  breadcrumbNode(url, crumbs),
  articleNode({ url, headline: e.data.title, description: e.data.description, published: d.published, modified: d.modified }),
  itemListNode(url, `${t.name} alternatives`, picks.map((x) => ({ name: tool(x).name, url: `${SITE}${best(x) ?? path}` }))),
  faqNode(url, faq),
];
---
<Base title={e.data.title} description={e.data.description} path={path} jsonld={jsonld}>
  <div class="wrap page">
    <article class="read" style="max-width:880px">
      <Breadcrumbs crumbs={crumbs} />
      <h1>{r.h1}</h1>
      <Byline modified={d.modified} published={d.published} verified={verified} />
      <Disclosure toolIds={picks} />
      {e.data.quickAnswer && <QuickAnswer text={e.data.quickAnswer} />}
      <p class="table-lead">Every alternative below with its real monthly bill for a 5-person team, next to {t.name}'s own (<Fig v={scenario(id, 'small').monthly} />/month), as of the dates on each pricing page.</p>
      <div class="tbl-wrap"><table class="data stack">
        <thead><tr><th scope="col">Tool</th><th scope="col">Layer</th><th scope="col" class="num">5-person team</th><th scope="col" class="num">Score</th></tr></thead>
        <tbody>
          <tr><th scope="row">{t.name} <span class="sub">the tool you are replacing</span></th><td data-label="Layer">{LAYER_LABELS[t.layer]}</td><td class="num" data-label="5-person team"><Fig v={scenario(id, 'small').monthly} /></td><td class="num" data-label="Score">{score(id)?.overall ? oneDecimal(score(id).overall) : '—'}</td></tr>
          {picks.map((x) => <tr><th scope="row">{best(x) ? <a href={best(x)}>{tool(x).name}</a> : tool(x).name}</th><td data-label="Layer">{LAYER_LABELS[tool(x).layer]}</td><td class="num" data-label="5-person team"><Fig v={scenario(x, 'small').monthly} /></td><td class="num" data-label="Score">{score(x)?.overall ? oneDecimal(score(x).overall) : '—'}</td></tr>)}
        </tbody>
      </table></div>
      {alt.reasons.map((reason) => (<>
        <h2 id={slugify(reason.reason).slice(0, 60)}>{reason.reason}</h2>
        <div class="picks">
          {reason.picks.map((pk) => (
            <div class="pick">
              <h3>{tool(pk.tool).name}</h3>
              <p data-prose>{pk.why}</p>
              <p class="small">Small team: <Fig v={scenario(pk.tool, 'small').monthly} suffix="/mo" />{best(pk.tool) && <> · <a href={best(pk.tool)}>real cost</a></>}</p>
              <AffLink tool={pk.tool} page={path} placement="alt-pick" label={`Visit ${tool(pk.tool).name}`} />
            </div>
          ))}
        </div>
      </>))}
      <PickCards candidates={picks} page={path} heading={`If you want one answer`} />
      <div class="prose-body" data-prose>
        <Content components={mdxComponents} />
      </div>
      <Provenance ids={[id, ...picks]} />
      <Faq items={faq} />
      <AuthorBox />
      <KeepReading links={related} />
      <Updated modified={d.modified} published={d.published} />
    </article>
  </div>
</Base>
