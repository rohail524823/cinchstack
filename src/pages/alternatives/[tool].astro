---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { SITE } from '../../lib/site.mjs';
import { tool, price, scenario, score, alternatives, faqs, sizeBasis } from '../../lib/data.mjs';
import { LAYER_LABELS } from '../../lib/schemas.mjs';
import { registry, relatedFor } from '../../lib/pages.mjs';
import { datesFor } from '../../lib/meta.mjs';
import { oneDecimal, slugify, poss } from '../../lib/format.mjs';
import { breadcrumbNode, articleNode, webPageNode, softwareRef, itemListNode, faqNode } from '../../lib/jsonld.mjs';
import { mdxComponents } from '../../components/mdx/index.mjs';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Byline from '../../components/Byline.astro';
import Disclosure from '../../components/Disclosure.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import AffLink from '../../components/AffLink.astro';
import PickCards from '../../components/PickCards.astro';
import Provenance from '../../components/Provenance.astro';
import Faq from '../../components/Faq.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import ServiceBox from '../../components/ServiceBox.astro';
import KeepReading from '../../components/KeepReading.astro';
import Updated from '../../components/Updated.astro';
import Fig from '../../components/Fig.astro';

export async function getStaticPaths() {
  const reg = await registry();
  return [...reg.values()].filter((r) => r.kind === 'alternatives').map((r) => ({ params: { tool: r.slug }, props: { r } }));
}
const { r } = Astro.props;
const id = r.slug;
const t = tool(id);
const alt = alternatives[id];
const e = r.entry;
const path = `/alternatives/${id}/`;
const url = `${SITE}${path}`;
const { Content } = await render(e);
const faq = faqs[`alternatives--${id}`]?.items ?? [];
const d = datesFor(e);
const picks = [...new Set(alt.reasons.flatMap((x) => x.picks.map((p) => p.tool)))];
// Each reason's H2 is a short label naming its picks ("Want a predictable bill: HubSpot or Zoho CRM");
// the full reason sentence leads the section. The label is the reason's schema-checked "short" field
// in src/data/alternatives/<tool>.json, required here so every section heading stays readable.
const orList = (names) => (names.length < 2 ? names.join('') : `${names.slice(0, -1).join(', ')} or ${names.at(-1)}`);
const sections = alt.reasons.map((reason, i) => {
  const short = reason.short;
  if (typeof short !== 'string' || !short.trim() || short.length > 48 || /[.:]$/.test(short)) throw new Error(`alternatives/${id}.json reason ${i + 1}: needs a "short" label of 1-48 characters with no closing punctuation`);
  return { ...reason, sid: slugify(short), heading: `${short}: ${orList(reason.picks.map((pk) => tool(pk.tool).name))}` };
});
const dupSid = sections.map((x) => x.sid).filter((x, i, a) => a.indexOf(x) !== i);
if (dupSid.length) throw new Error(`alternatives/${id}.json: two reasons share the heading id ${dupSid[0]}`);
const verified = [id, ...picks].map((x) => price(x).checkedOn).sort()[0];
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools/' }, { label: `${t.name} alternatives` }];
const related = await relatedFor(e.id, e.data.related);
const reg = await registry();
const best = (x) => (reg.has(`/tools/${x}/pricing/`) ? `/tools/${x}/pricing/` : reg.has(`/tools/${x}/`) ? `/tools/${x}/` : null);
const jsonld = [
  breadcrumbNode(url, crumbs),
  articleNode({ url, headline: e.data.title, description: e.data.description, published: d.published, modified: d.modified, about: softwareRef(id, (x) => reg.has(x)), mentions: picks.map((x) => softwareRef(x, (q) => reg.has(q))) }),
  webPageNode({ url, name: e.data.title, description: e.data.description, lastReviewed: verified, article: true }),
  itemListNode(url, `${t.name} alternatives`, picks.map((x) => ({ name: tool(x).name, url: `${SITE}${best(x) ?? path}` }))),
  faqNode(url, faq),
];
---
<Base title={e.data.title} description={e.data.description} path={path} jsonld={jsonld}>
  <div class="wrap page">
    <article class="read" style="max-width:880px">
      <Breadcrumbs crumbs={crumbs} />
      <h1>{r.h1}</h1>
      <Byline modified={d.modified} published={d.published} verified={verified} ids={[id, ...picks]} />
      <Disclosure toolIds={[id, ...picks]} page={path} />
      {e.data.quickAnswer && <QuickAnswer text={e.data.quickAnswer} />}
      <PickCards candidates={alt.sameJob ?? picks.filter((x) => tool(x).layer === t.layer)} page={path} heading={`If you want one answer`} />
      <p class="table-lead">Every alternative below with its real monthly bill for a small team, next to {poss(t.name)} own (<Fig v={scenario(id, 'small').monthly} floor={scenario(id, 'small').floor} />/month), as of the dates on each pricing page. Each bill, {poss(t.name)} included, is sized for the job that tool does, shown under the figure.</p>
      <div class="tbl-wrap"><table class="data stack">
        <thead><tr><th scope="col">Tool</th><th scope="col">Layer</th><th scope="col" class="num">Small team</th><th scope="col" class="num">Score</th></tr></thead>
        <tbody>
          <tr><th scope="row">{t.name} <span class="sub">the tool you are replacing</span></th><td data-label="Layer">{LAYER_LABELS[t.layer]}</td><td class="num" data-label="Small team"><Fig v={scenario(id, 'small').monthly} floor={scenario(id, 'small').floor} /><span class="sub">{sizeBasis(id, 'small')}</span></td><td class="num" data-label="Score">{score(id)?.overall ? <a href="/methodology/#scoring" aria-label={`${poss(t.name)} score, ${oneDecimal(score(id).overall)} out of 5: how we score`}>{oneDecimal(score(id).overall)}</a> : '—'}</td></tr>
          {picks.map((x) => <tr><th scope="row">{best(x) ? <a href={best(x)}>{tool(x).name}</a> : tool(x).name}</th><td data-label="Layer">{LAYER_LABELS[tool(x).layer]}</td><td class="num" data-label="Small team"><Fig v={scenario(x, 'small').monthly} floor={scenario(x, 'small').floor} /><span class="sub">{sizeBasis(x, 'small')}</span></td><td class="num" data-label="Score">{score(x)?.overall ? <a href="/methodology/#scoring" aria-label={`${poss(tool(x).name)} score, ${oneDecimal(score(x).overall)} out of 5: how we score`}>{oneDecimal(score(x).overall)}</a> : '—'}</td></tr>)}
        </tbody>
      </table></div>
      <p class="small muted"><a href="/methodology/#scoring">How scores and picks work</a></p>
      {sections.map((reason) => (<>
        <h2 id={reason.sid}>{reason.heading}</h2>
        <p class="reason-lead" data-prose>{reason.reason}</p>
        <div class="picks">
          {reason.picks.map((pk) => (
            <div class="pick">
              <h3>{tool(pk.tool).name}</h3>
              <p data-prose>{pk.why}</p>
              <p class="small">Small team: <Fig v={scenario(pk.tool, 'small').monthly} suffix="/mo" floor={scenario(pk.tool, 'small').floor} />{best(pk.tool) && <> · <a href={best(pk.tool)}>real cost</a></>}{sizeBasis(pk.tool, 'small') && <><br /><span class="muted">{sizeBasis(pk.tool, 'small')}</span></>}</p>
              <AffLink tool={pk.tool} page={path} placement="alt-pick" label={`Visit ${tool(pk.tool).name}`} />
            </div>
          ))}
        </div>
      </>))}
      <div class="prose-body" data-prose>
        <Content components={mdxComponents} />
      </div>
      <Provenance ids={[id, ...picks]} />
      <Faq items={faq} />
      <ServiceBox scope="alternatives" ids={[id]} />
      <AuthorBox />
      <KeepReading links={related} />
      <Updated modified={d.modified} published={d.published} />
    </article>
  </div>
</Base>
