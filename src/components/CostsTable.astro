---
import { price, tool } from '../lib/data.mjs';
import { longDate, poss } from '../lib/format.mjs';
import Fig from './Fig.astro';
interface Props { id: string }
const t = tool(Astro.props.id);
const p = price(Astro.props.id);
const date = longDate(p.checkedOn);
const planName = (id) => p.plans.find((x) => x.id === id)?.name ?? id;
const SHOW = 8; // longer tables show the first rows and fold the rest
const head = (a) => a.slice(0, SHOW);
const rest = (a) => a.slice(SHOW);
const addOnRow = (a) => ({ name: a.name, v: a.price, unit: a.unit, note: [a.appliesTo?.length ? `Plans: ${a.appliesTo.map(planName).join(', ')}.` : '', a.note ?? ''].join(' ').trim() || '—' });
const usageRow = (u) => ({ name: u.name, v: u.rate, unit: u.unit, note: u.note ?? '—' });
// Lead sentences are built from the data, so each one names the tool, its figures and the check date.
const count = (n, one, many = `${one}s`) => `${n} ${n === 1 ? one : many}`;
const list = (a) => (a.length <= 1 ? a.join('') : `${a.slice(0, -1).join(', ')} and ${a.at(-1)}`);
const range = (vals) => { const v = vals.filter((x) => typeof x === 'number'); return v.length ? { lo: Math.min(...v), hi: Math.max(...v) } : null; };
const addOnRange = range(p.addOns.map((a) => a.price));
const usageRange = range(p.usage.map((u) => u.rate));
const KIND = { 'one-time': ['one-time charge', 'one-time charges'], monthly: ['recurring charge', 'recurring charges'], 'per-transaction': ['fee on sales', 'fees on sales'], 'percent-of-sales': ['fee on sales', 'fees on sales'], other: ['other cost or condition', 'other costs or conditions'] };
const kinds = {};
for (const x of p.extraCosts) { const k = KIND[x.kind] ?? KIND.other; kinds[k[0]] = { k, n: (kinds[k[0]]?.n ?? 0) + 1 }; }
const zeros = p.extraCosts.filter((x) => x.amount === 0).length;
const zeroText = !zeros ? '' : zeros === p.extraCosts.length ? (zeros === 1 ? ', which is zero' : ', all of them zero') : `, ${zeros} of them zero`;
const kindText = list(Object.values(kinds).map(({ k, n }) => count(n, k[0], k[1]))) + zeroText;
const fixed = p.extraCosts.filter((x) => typeof x.amount === 'number' && x.amount > 0 && x.kind !== 'percent-of-sales').sort((a, b) => b.amount - a.amount)[0];
const region = (what) => ({ class: 'tbl-wrap', tabindex: '0', role: 'region', 'aria-label': what });
---
{p.addOns.length > 0 && (<>
  {p.addOns.length === 1
    ? <p class="table-lead">{`${t.name} sells one paid add-on on top of its plans as of ${date}: ${p.addOns[0].name} at `}<Fig v={p.addOns[0].price} />{`, charged ${p.addOns[0].unit}.`}</p>
    : <p class="table-lead">{`${t.name} sells ${p.addOns.length} paid add-ons on top of its plans as of ${date}, priced from `}<Fig v={addOnRange.lo} /> to <Fig v={addOnRange.hi} />{` each; the table gives what each ${t.name} add-on is charged per.`}</p>}
  {[head(p.addOns), rest(p.addOns)].map((rows, i) => rows.length > 0 && (() => { const tbl = (
    <div {...region(i === 0 ? `${poss(t.name)} paid add-ons` : `More of ${poss(t.name)} paid add-ons`)}><table class="data stack">
      <thead><tr><th scope="col">Add-on</th><th scope="col" class="num">Price</th><th scope="col">Charged</th><th scope="col">Notes</th></tr></thead>
      <tbody>{rows.map(addOnRow).map((r) => <tr><th scope="row">{r.name}</th><td class="num" data-label="Price"><Fig v={r.v} /></td><td data-label="Charged">{r.unit}</td><td data-label="Notes">{r.note}</td></tr>)}</tbody>
    </table></div>); return i === 0 ? tbl : <details class="more"><summary>Show {rows.length} more add-ons</summary>{tbl}</details>; })())}
</>)}
{p.usage.length > 0 && (<>
  {p.usage.length === 1
    ? <p class="table-lead">{`${t.name} bills one usage-based charge on top of the subscription, at the rate recorded on ${date}: ${p.usage[0].name} at `}<Fig v={p.usage[0].rate} />{` ${p.usage[0].unit}.`}</p>
    : <p class="table-lead">{`${t.name} bills ${p.usage.length} usage-based charges per unit on top of the subscription, at rates recorded on ${date} that run from `}<Fig v={usageRange.lo} /> to <Fig v={usageRange.hi} />{` depending on what is metered.`}</p>}
  {[head(p.usage), rest(p.usage)].map((rows, i) => rows.length > 0 && (() => { const tbl = (
    <div {...region(i === 0 ? `${poss(t.name)} usage-based charges` : `More of ${poss(t.name)} usage-based charges`)}><table class="data stack">
      <thead><tr><th scope="col">Usage</th><th scope="col" class="num">Rate</th><th scope="col">Per</th><th scope="col">Notes</th></tr></thead>
      <tbody>{rows.map(usageRow).map((r) => <tr><th scope="row">{r.name}</th><td class="num" data-label="Rate"><Fig v={r.v} /></td><td data-label="Per">{r.unit}</td><td data-label="Notes">{r.note}</td></tr>)}</tbody>
    </table></div>); return i === 0 ? tbl : <details class="more"><summary>Show {rows.length} more usage rates</summary>{tbl}</details>; })())}
</>)}
{p.extraCosts.length > 0 && (<>
  <p class="table-lead">{`${t.name} lists ${count(p.extraCosts.length, 'other cost')} beyond its plans, add-ons and usage rates, recorded on ${date}: ${kindText}`}{fixed ? <>{`. The largest fixed one is ${fixed.label}, at `}<data value={String(fixed.amount)} data-fig>{fixed.display}</data>.</> : '.'}</p>
  {[head(p.extraCosts), rest(p.extraCosts)].map((rows, i) => rows.length > 0 && (() => { const tbl = (
    <div {...region(i === 0 ? `Other costs of ${t.name}` : `More other costs of ${t.name}`)}><table class="data stack">
      <thead><tr><th scope="col">Cost</th><th scope="col">Amount</th><th scope="col">Notes</th></tr></thead>
      <tbody>{rows.map((x) => <tr><th scope="row">{x.label}</th><td data-label="Amount">{x.amount !== null && x.kind !== 'percent-of-sales' ? <data value={String(x.amount)} data-fig>{x.display}</data> : x.display}</td><td data-label="Notes">{x.note ?? '—'}</td></tr>)}</tbody>
    </table></div>); return i === 0 ? tbl : <details class="more"><summary>Show {rows.length} more costs</summary>{tbl}</details>; })())}
</>)}
