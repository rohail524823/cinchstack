---
// A figure rendered from data. The check script treats [data-fig] values as sourced.
import { money } from '../lib/format.mjs';
interface Props { v: number | null; suffix?: string; decimals?: number }
const { v, suffix = '', decimals } = Astro.props;
---
{v === null || v === undefined ? <span>—</span> : <data value={String(v)} data-fig>{money(v, { decimals })}{suffix}</data>}
