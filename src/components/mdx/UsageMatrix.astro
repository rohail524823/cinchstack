---
// MDX token: <UsageMatrix /> renders GoHighLevel's monthly usage bill on top of the plan, for a
// grid of texts and emails, from the US rates in src/data/pricing/gohighlevel.json. It uses the same
// lines as the site's real-bill scenarios (one local number, one A2P campaign, every text an
// outbound segment with the carrier fee, and the 5% markup on carrier and A2P fees), so a cell at
// a scenario's volumes equals that scenario's usage.
import { price } from '../../lib/data.mjs';
import { longDate } from '../../lib/format.mjs';
import Fig from '../Fig.astro';
interface Props { texts?: number[]; emails?: number[] }
const { texts = [200, 1000, 2500, 5000, 10000], emails = [2000, 20000, 50000, 100000] } = Astro.props;
const p = price('gohighlevel');
const rate = (id) => p.usage.find((u) => u.id === id)?.rate;
const sms = rate('sms-segment'), carrier = rate('sms-carrier-fee'), num = rate('local-number'), a2p = rate('a2p-campaign-low-volume-mixed'), mail = rate('lc-email');
const ok = [sms, carrier, num, a2p, mail].every((x) => typeof x === 'number');
const usage = (t, e) => Math.round((t * (sms + carrier) + num + a2p + 0.05 * (t * carrier + a2p) + (e / 1000) * mail) * 100) / 100;
const n = (x) => x.toLocaleString('en-US');
---
{ok && (<>
  <p class="table-lead">GoHighLevel's monthly usage charges on top of the plan price, by texts and emails sent, at the US rates recorded on {longDate(p.checkedOn)}. Each cell counts one local number, one A2P campaign, every text as one outbound segment with the carrier fee, and HighLevel's 5% markup on carrier and A2P fees.</p>
  <div class="tbl-wrap"><table class="data">
    <thead><tr><th scope="col">Texts a month</th>{emails.map((e) => <th scope="col" class="num">{n(e)} emails</th>)}</tr></thead>
    <tbody>
      {texts.map((t) => <tr><th scope="row">{n(t)}</th>{emails.map((e) => <td class="num" data-label={`${n(e)} emails`}><Fig v={usage(t, e)} /></td>)}</tr>)}
    </tbody>
  </table></div>
</>)}
