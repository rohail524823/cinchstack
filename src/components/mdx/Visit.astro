---
// MDX token: <Visit tool="gohighlevel" /> puts the tool's link (paid, with its note, when the
// tool pays us on this page; plain otherwise) where the prose has just argued for it.
import AffLink from '../AffLink.astro';
import { tool } from '../../lib/data.mjs';
import { poss } from '../../lib/format.mjs';
interface Props { tool: string; label?: string; placement?: string }
const { tool: id, label, placement = 'prose' } = Astro.props;
---
<div class="cta-row prose-cta"><AffLink tool={id} href={tool(id).pricingUrl} page={Astro.url.pathname} placement={placement} label={label ?? `See ${poss(tool(id).name)} plans and prices`} /></div>
