---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
{items.length > 0 && (
  <section class="faq" data-faq>
    <h2 id="faq">Frequently asked questions</h2>
    {items.map((it) => (
      <details>
        <summary data-faq-q>{it.q}</summary>
        {it.a.split(/\n\n+/).map((para) => <p data-faq-a>{para}</p>)}
      </details>
    ))}
  </section>
)}
