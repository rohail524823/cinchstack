---
// Every affiliate program we have joined or plan to join, straight from programs.json.
import { programs, tools } from '../../lib/data.mjs';
import { longDate } from '../../lib/format.mjs';
const STATUS = { approved: 'Approved', applied: 'Applied, waiting', 'not-applied': 'Not applied yet', declined: 'Declined', none: 'No program' };
const rows = Object.entries(programs).map(([key, p]) => ({ key, p, name: tools[key]?.name ?? p.label.replace(/ affiliate program$/i, ''), live: p.status === 'approved' && Boolean(p.template) }));
---
<div class="tbl-wrap">
  <table class="data stack">
    <thead><tr><th scope="col">Vendor</th><th scope="col">Status</th><th scope="col">Links on this site</th><th scope="col">What the program pays</th></tr></thead>
    <tbody>
      {rows.map(({ p, name, live }) => (
        <tr>
          <th scope="row" data-label="Vendor">{name}</th>
          <td data-label="Status">{STATUS[p.status]}{p.approvedOn ? ` (${longDate(p.approvedOn)})` : ''}</td>
          <td data-label="Links">{live ? 'Amber affiliate buttons' : 'Plain links, no commission'}</td>
          <td data-label="Pays">{p.status === 'approved' ? p.terms.split(/(?<=\.)\s/)[0] : 'We have not joined this program.'}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
