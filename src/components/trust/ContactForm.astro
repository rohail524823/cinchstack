---
// Netlify Forms: handled at the edge, no JavaScript, honeypot for spam.
---
<form class="form" name="contact" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="company">
  <input type="hidden" name="form-name" value="contact">
  <p class="hp" aria-hidden="true"><label>Leave this empty <input name="company" tabindex="-1" autocomplete="off"></label></p>
  <p><label for="c-topic">What is this about?</label>
    <select id="c-topic" name="topic" required>
      <option value="wrong-price">A price on this site is wrong or out of date</option>
      <option value="vendor">I work for a vendor listed here</option>
      <option value="data">Using the pricing dataset</option>
      <option value="other">Something else</option>
    </select></p>
  <p><label for="c-page">Which page? <span class="muted">(optional)</span></label><input id="c-page" name="page" type="url" placeholder="https://cinchstack.com/tools/…"></p>
  <p><label for="c-msg">Your message</label><textarea id="c-msg" name="message" rows="6" required></textarea></p>
  <p><label for="c-email">Your email <span class="muted">(optional, only if you want a reply)</span></label><input id="c-email" name="email" type="email" autocomplete="email"></p>
  <p><button class="btn btn-primary" type="submit">Send</button></p>
</form>
